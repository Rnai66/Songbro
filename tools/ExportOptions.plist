<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists/PSL1.0.dtd">
<!-- Upload an archive to App Store Connect / TestFlight:
     xcodebuild -exportArchive -archivePath SongBro.xcarchive \
       -exportOptionsPlist tools/ExportOptions.plist -exportPath export -allowProvisioningUpdates -->
<plist version="1.0">
<dict>
	<key>method</key><string>app-store-connect</string>
	<key>destination</key><string>upload</string>
	<key>teamID</key><string>H4X9654279</string>
	<key>signingStyle</key><string>automatic</string>
	<key>uploadSymbols</key><true/>
	<key>manageAppVersionAndBuildNumber</key><true/>
</dict>
</plist>
